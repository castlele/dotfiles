---@class Dot
Dot = {}

require("dottools.cmd")
require("dottools.log")
require("dottools.ui")

Dot.home = (function()
  local home = os.getenv("HOME")

  if not home then
    Dot:abort("Can't get $HOME value")
  end

  return home
end)()

Dot.configPath = (function()
  return Dot.home .. "/.config"
end)()

---@type "linux-gnu"|"darwin"
Dot.osType = (function()
  local handle = io.popen("uname -s")
  local name = handle and handle:read("*l")
  if handle then handle:close() end

  local types = { Darwin = "darwin", Linux = "linux-gnu" }
  local type = types[name or ""]

  if not type then
    Dot:abort("Can't get OS type from uname: " .. tostring(name))
  end

  return type
end)()

function Dot:printHelp()
  print("dot init --all               init every project")
  print("dot init <name>              init project by name")
  print(
    "dot init <name1, name2...>   init projects passed by name separated by space")
  print("dot deinit --all             deinit all projects")
  print("dot deinit <name>            deinit project by name separated by space")
  print("dot deinit <name1, name2...> deinit project by name separated by space")
  self:exit(0)
end

local configs = {
  "claude",
  "test",
  "test2",
}
local args = { ... }

local function assertArguments()
  if #args == 0 then
    Dot:printHelp()
  end
end

--- @param projects table<string>
--- @param funName string
local function runForProject(projects, funName)
  local funs = {}

  for _, proj in ipairs(projects) do
    local ok, projFile = pcall(dofile, proj .. "/dot.lua")

    if ok then
      if not projFile then
        Dot.w(string.format("No project file found: %s!", proj))
      elseif not projFile[funName] then
        Dot.w(string.format(
          "No %s function found for project: %s!",
          funName, proj
        ))
      else
        local fun = projFile[funName]

        table.insert(funs, function()
          print(string.format("Calling %s for %s", funName, proj))
          return fun(proj)
        end)
      end
    else
      Dot.w("Can't run dot.lua file for project " .. proj)
    end
  end

  Dot:progress(funName, funs)
end

local function main()
  assertArguments()

  local cmd = args[1]

  local function execute(command, name)
    if #args <= 1 then
      Dot.w("Don't know what to " .. name)
      Dot:printHelp()
    end

    if args[2] == "--all" then
      command(configs)
    else
      local names = {}

      for i = 2, #args do
        table.insert(names, args[i])
      end

      command(names)
    end
  end

  if cmd == "init" then
    execute(function(projects) runForProject(projects, "init") end, cmd)
  elseif cmd == "deinit" then
    execute(function(projects) runForProject(projects, "deinit") end, cmd)
  else
    Dot:printHelp()
  end
end

main()
